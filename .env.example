# Rename this file to `.env` and fill in your own values.

# Telegram bot token obtained via BotFather
BOT_TOKEN=

# The Telegram channel ID or username that users must join before using the bot
# Example: -100123456789 or @valera_podskazhet
TELEGRAM_CHANNEL_ID=

# OpenAI API key used to call GPT‑4o.  Keep this secret.
OPENAI_API_KEY=

# Provider token for Telegram Stars payments.  For digital goods you can use the
# special `STARS` token provided by Telegram.  See
# https://core.telegram.org/bots/payments#payments-in-telegram-stars for details.
PROVIDER_TOKEN=STARS

# Optional: Comma separated list of administrator Telegram IDs who are allowed
# to broadcast messages or receive debug information.
ADMINS=